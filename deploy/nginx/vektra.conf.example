# Nginx reverse proxy with TLS termination for Vektra (NFR-012).
#
# Usage:
#   1. Copy to /etc/nginx/sites-available/vektra.conf
#   2. Replace YOUR_DOMAIN with your actual domain
#   3. Place TLS certificates at the paths below (or use certbot)
#   4. ln -s /etc/nginx/sites-available/vektra.conf /etc/nginx/sites-enabled/
#   5. nginx -t && systemctl reload nginx

upstream vektra_backend {
    server 127.0.0.1:8000;
    keepalive 32;
}

# Redirect HTTP to HTTPS
server {
    listen 80;
    server_name YOUR_DOMAIN;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name YOUR_DOMAIN;

    # TLS certificates
    ssl_certificate     /etc/ssl/certs/vektra.crt;
    ssl_certificate_key /etc/ssl/private/vektra.key;

    # TLS 1.2+ only (NFR-012)
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    # Security headers
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;

    # Request size limit (matches VEKTRA_MAX_FILE_SIZE_MB default)
    client_max_body_size 50m;

    location / {
        proxy_pass http://vektra_backend;
        proxy_http_version 1.1;

        # Correlation ID propagation (ARCH-008)
        proxy_set_header X-Request-ID $request_id;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Host $host;

        # WebSocket/SSE support (streaming responses)
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_read_timeout 300s;
    }

    # Health check (no TLS overhead for internal monitoring)
    location /health {
        proxy_pass http://vektra_backend/health;
        access_log off;
    }

    # Prometheus metrics (restricted to internal network)
    location /metrics {
        proxy_pass http://vektra_backend/metrics;
        allow 10.0.0.0/8;
        allow 172.16.0.0/12;
        allow 192.168.0.0/16;
        deny all;
        access_log off;
    }
}
