# ==========================================================================
# Pull a published release image instead of building from source (INFRA-007)
#
# Usage:
#   1. Copy to docker-compose.image.yml (repo root)
#   2. Set VEKTRA_VERSION in .env (or the shell) to a published tag, e.g.
#      0.6.1, or 0.6.1-ocr for the OCR-enabled variant
#   3. Set COMPOSE_FILE=docker-compose.yml:docker-compose.image.yml in .env,
#      so every compose command (pull, up, ps, logs) merges both files
#   4. docker compose pull
#   5. docker compose up -d
#
# Published tags: https://github.com/vektralabs/vektra-stack/pkgs/container/vektra
#
# This replaces the vektra service's `build:` directive with a static
# `image:` reference, so step 3 (`docker compose pull`) fetches
# ghcr.io/vektralabs/vektra:${VEKTRA_VERSION} instead of building from a
# git checkout.
# ==========================================================================

services:
  vektra:
    build: !reset null
    image: ghcr.io/vektralabs/vektra:${VEKTRA_VERSION:?set VEKTRA_VERSION, e.g. 0.6.1 or 0.6.1-ocr}
