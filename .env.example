# ==========================================================================
# Vektra environment configuration
# Copy to .env and edit: cp .env.example .env
# ==========================================================================

# --------------------------------------------------------------------------
# Required
# --------------------------------------------------------------------------

# LLM model in litellm format. Examples:
#   ollama/llama3         (local Ollama, no API key needed)
#   openai/gpt-4o         (requires VEKTRA_LLM_API_KEY or OPENAI_API_KEY)
#   anthropic/claude-sonnet-4-20250514 (requires VEKTRA_LLM_API_KEY or ANTHROPIC_API_KEY)
VEKTRA_LLM_PROVIDER=ollama/llama3

# --------------------------------------------------------------------------
# LLM provider keys (set one based on your VEKTRA_LLM_PROVIDER)
# --------------------------------------------------------------------------

# Generic LLM API key (passed to litellm)
# VEKTRA_LLM_API_KEY=

# Or set provider-specific keys directly:
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# --------------------------------------------------------------------------
# Security
# --------------------------------------------------------------------------

# Single-use credential for creating the first API key.
# After first use this value is consumed and ignored.
# VEKTRA_ADMIN_BOOTSTRAP_KEY=change-me-on-first-deploy

# Environment mode: "development" or "production".
# In production, non-TLS connections are rejected.
# VEKTRA_ENV=development

# --------------------------------------------------------------------------
# Database
# --------------------------------------------------------------------------

# PostgreSQL connection string (asyncpg driver).
# Default matches the postgres service in docker-compose.yml.
# VEKTRA_DATABASE_URL=postgresql+asyncpg://vektra:vektra@postgres:5432/vektra

# Password for the postgres container (also used in VEKTRA_DATABASE_URL).
# POSTGRES_PASSWORD=vektra

# --------------------------------------------------------------------------
# Embedding
# --------------------------------------------------------------------------

# Embedding provider and model.
# VEKTRA_EMBEDDING_PROVIDER=sentence-transformers
# VEKTRA_EMBEDDING_MODEL=all-MiniLM-L6-v2

# --------------------------------------------------------------------------
# Vector store
# --------------------------------------------------------------------------

# VEKTRA_VECTOR_STORE_PROVIDER=pgvector
# VEKTRA_ACTIVE_INDEX_VERSION=1

# --------------------------------------------------------------------------
# Query pipeline
# --------------------------------------------------------------------------

# VEKTRA_QUERY_PIPELINE=simple
# VEKTRA_MIN_RELEVANCE_SCORE=0.3
# VEKTRA_CHUNK_DEDUP_ENABLED=true
# VEKTRA_RESPONSE_TOKEN_RESERVE=1024
# VEKTRA_CONTEXT_CHUNK_RATIO=0.6
# VEKTRA_PROMPT_TEMPLATES_DIR=

# --------------------------------------------------------------------------
# Ingestion
# --------------------------------------------------------------------------

# VEKTRA_CHUNKING_STRATEGY=fixed
# VEKTRA_CHUNK_SIZE=1000
# VEKTRA_CHUNK_OVERLAP=200
# VEKTRA_MAX_FILE_SIZE_MB=50
# VEKTRA_DOCUMENT_EXTRACTOR=pdfplumber

# --------------------------------------------------------------------------
# LLM fallback
# --------------------------------------------------------------------------

# Fallback model when primary times out.
# VEKTRA_LLM_FALLBACK_MODEL=
# VEKTRA_LLM_FALLBACK_TIMEOUT_MS=30000
# VEKTRA_LLM_CONTEXT_ONLY_ENABLED=true

# --------------------------------------------------------------------------
# Server
# --------------------------------------------------------------------------

# VEKTRA_PORT=8000
# VEKTRA_STARTUP_LLM_CHECK=true

# --------------------------------------------------------------------------
# Observability
# --------------------------------------------------------------------------

# VEKTRA_MAX_CONVERSATION_TURNS=10
# VEKTRA_AUDIT_RETENTION_DAYS=90
# VEKTRA_EVAL_MODE=false

# --------------------------------------------------------------------------
# Phase 2 (not active in Phase 1)
# --------------------------------------------------------------------------

# VEKTRA_SAFEGUARD_MODE=passthrough
# VEKTRA_MULTI_TENANT=false
# VEKTRA_CONVERSATION_KEY=
# VEKTRA_RETENTION_DAYS=
# VEKTRA_ANALYTICS_RETENTION_DAYS=
# VEKTRA_SPARSE_EMBEDDING_PROVIDER=
# VEKTRA_SPARSE_EMBEDDING_MODEL=
