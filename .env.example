# ==========================================================================
# Vektra environment configuration
# Copy to .env and edit: cp .env.example .env
# ==========================================================================

# --------------------------------------------------------------------------
# Required
# --------------------------------------------------------------------------

# LLM model in litellm format. Uncomment ONE of the following:
#   VEKTRA_LLM_PROVIDER=ollama/llama3         (requires --profile local-llm)
#   VEKTRA_LLM_PROVIDER=openai/gpt-4o         (requires VEKTRA_LLM_API_KEY or OPENAI_API_KEY)
#   VEKTRA_LLM_PROVIDER=anthropic/claude-sonnet-4-20250514 (requires VEKTRA_LLM_API_KEY or ANTHROPIC_API_KEY)
# VEKTRA_LLM_PROVIDER=ollama/llama3

# --------------------------------------------------------------------------
# LLM provider keys (set one based on your VEKTRA_LLM_PROVIDER)
# --------------------------------------------------------------------------

# Generic LLM API key (passed to litellm)
# VEKTRA_LLM_API_KEY=

# Custom API base URL for OpenAI-compatible providers (vLLM, LM Studio, etc.)
# When set, litellm routes requests to this URL instead of the provider default.
# Example: VEKTRA_LLM_API_BASE=http://localhost:8000/v1
# VEKTRA_LLM_API_BASE=

# Extra JSON body forwarded to litellm. Useful for vLLM thinking models
# (Qwen3.5, DeepSeek-R1) to disable thinking mode.
# Example: VEKTRA_LLM_EXTRA_BODY={"chat_template_kwargs": {"enable_thinking": false}}
# VEKTRA_LLM_EXTRA_BODY=

# Or set provider-specific keys directly:
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# --------------------------------------------------------------------------
# Security
# --------------------------------------------------------------------------

# Single-use credential for creating the first API key.
# After first use this value is consumed and ignored.
# VEKTRA_ADMIN_BOOTSTRAP_KEY=change-me-on-first-deploy

# Environment mode: "development" or "production".
# In production, non-TLS connections are rejected.
# VEKTRA_ENV=development

# --------------------------------------------------------------------------
# Database
# --------------------------------------------------------------------------

# PostgreSQL connection string (asyncpg driver).
# Default matches the postgres service in docker-compose.yml.
# VEKTRA_DATABASE_URL=postgresql+asyncpg://vektra:vektra@postgres:5432/vektra

# Password for the postgres container (also used in VEKTRA_DATABASE_URL).
# POSTGRES_PASSWORD=vektra

# --------------------------------------------------------------------------
# Embedding
# --------------------------------------------------------------------------

# Embedding provider and model.
# VEKTRA_EMBEDDING_PROVIDER=sentence-transformers
# VEKTRA_EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
# Remote embedding via Text Embeddings Inference (VEKTRA_EMBEDDING_PROVIDER=tei):
# VEKTRA_TEI_URL=http://localhost:8080
# VEKTRA_TEI_API_KEY=

# --------------------------------------------------------------------------
# Vector store
# --------------------------------------------------------------------------

# VEKTRA_VECTOR_STORE_PROVIDER=pgvector
# VEKTRA_ACTIVE_INDEX_VERSION=1

# Qdrant settings (only used when VEKTRA_VECTOR_STORE_PROVIDER=qdrant)
# VEKTRA_QDRANT_URL=http://localhost:6333
# VEKTRA_QDRANT_API_KEY=
# VEKTRA_QDRANT_COLLECTION=vektra

# --------------------------------------------------------------------------
# Query pipeline
# --------------------------------------------------------------------------

# VEKTRA_QUERY_PIPELINE=advanced
# VEKTRA_MIN_RELEVANCE_SCORE=0.15
# VEKTRA_CHUNK_DEDUP_ENABLED=true
# VEKTRA_RETRIEVAL_RESCUE_TOP_K=0
# VEKTRA_RETRIEVAL_RESCUE_FLOOR=0.02
# VEKTRA_PARENT_EXPANSION_ENABLED=false
# VEKTRA_RESPONSE_TOKEN_RESERVE=2048
# VEKTRA_CONTEXT_CHUNK_RATIO=0.6
# VEKTRA_PROMPT_TEMPLATES_DIR=

# Default RAG grounding policy. Per-namespace override via
# PATCH /api/v1/admin/namespaces/{id}/config.
#   strict  - answer from retrieved context + history only
#   hybrid  - fall back to model knowledge when confident
# VEKTRA_PROMPT_GROUNDING_MODE=strict

# Query rewriting (AdvancedQueryPipeline)
# VEKTRA_QUERY_REWRITE_ENABLED=true
# VEKTRA_QUERY_REWRITE_MODEL=

# Reranking
# VEKTRA_RERANK_ENABLED=true
# VEKTRA_RERANK_PROVIDER=cross-encoder
# VEKTRA_RERANK_MODEL=BAAI/bge-reranker-v2-m3
# Candidates fetched from vector search for reranking (the post-rerank cut
# is the request's top_k):
# VEKTRA_RERANK_FETCH_K=20
# API key for API-based providers (cohere):
# VEKTRA_RERANK_API_KEY=
# Remote reranking via TEI (VEKTRA_RERANK_PROVIDER=tei, one instance per model):
# VEKTRA_RERANK_TEI_URL=http://localhost:8080
# VEKTRA_RERANK_TEI_API_KEY=

# --------------------------------------------------------------------------
# Ingestion
# --------------------------------------------------------------------------

# VEKTRA_CHUNKING_STRATEGY=fixed
# VEKTRA_CHUNK_SIZE=500
# VEKTRA_CHUNK_OVERLAP=100
# VEKTRA_MAX_FILE_SIZE_MB=50
# VEKTRA_DOCUMENT_EXTRACTOR=pdfplumber
# VEKTRA_TABLE_SPLIT=false

# --------------------------------------------------------------------------
# LLM fallback
# --------------------------------------------------------------------------

# Fallback model when primary times out.
# VEKTRA_LLM_FALLBACK_MODEL=
# VEKTRA_LLM_FALLBACK_TIMEOUT_MS=60000
# VEKTRA_LLM_CONTEXT_WINDOW=           # Required for models not in litellm registry (e.g. local vLLM).
#   Set to the model's actual context length. Check your provider:
#     vLLM: curl /v1/models → max_model_len
#     Ollama: ollama show <model> → context_length
#   If unset, litellm tries to look it up; for unknown models it falls back
#   to 4096, which causes most retrieved chunks to be discarded (BUG-017).
#   Examples: Qwen 3.5 27B → 262144, Llama 3 8B → 8192, GPT-4o → 128000
# VEKTRA_LLM_CONTEXT_ONLY_ENABLED=true

# --------------------------------------------------------------------------
# Server
# --------------------------------------------------------------------------

# VEKTRA_PORT=8000
# VEKTRA_STARTUP_LLM_CHECK=true

# Optional service ports (host-side). Override to avoid port conflicts.
# OLLAMA_PORT=11434
# QDRANT_PORT=6333
# TEI_PORT=8080

# --------------------------------------------------------------------------
# Observability
# --------------------------------------------------------------------------

# VEKTRA_MAX_CONVERSATION_TURNS=10
# VEKTRA_AUDIT_RETENTION_DAYS=90
# VEKTRA_EVAL_MODE=false

# Persist QueryTrace rows for every query (DEBT-011). When unset, defaults
# to true if vektra-analytics is configured, false otherwise.
# VEKTRA_ANALYTICS_STORE_TRACES=

# Log original and rewritten query text at debug level. Development only;
# query text is otherwise redacted from logs.
# VEKTRA_DEBUG_LOG_QUERIES=false

# --------------------------------------------------------------------------
# Security
# --------------------------------------------------------------------------

# VEKTRA_SAFEGUARD_MODE=passthrough
# VEKTRA_MULTI_TENANT=false
# Symmetric key for conversation content (pgcrypto). UNSET = conversations are
# NOT persisted: the in-memory store is used, history dies with the process and
# the student history endpoints return ERR-LEARN-001. Generate with
# `openssl rand -base64 32`. The key cannot be rotated in place: changing it
# makes existing turns undecryptable. See docs/reference/configuration.md.
# VEKTRA_CONVERSATION_KEY=
# VEKTRA_PII_CHUNK_THRESHOLD=3
# VEKTRA_RETENTION_DAYS=
# VEKTRA_ANALYTICS_RETENTION_DAYS=
# VEKTRA_SPARSE_EMBEDDING_PROVIDER=
# VEKTRA_SPARSE_EMBEDDING_MODEL=

# --------------------------------------------------------------------------
# Webhooks
# --------------------------------------------------------------------------

# Webhook endpoint for event delivery. Disabled when unset.
# VEKTRA_WEBHOOK_URL=
# VEKTRA_WEBHOOK_SECRET=
# VEKTRA_WEBHOOK_TIMEOUT=5.0

# --------------------------------------------------------------------------
# Learn (e-learning vertical)
# --------------------------------------------------------------------------

# JWT signing secret for dashboard tokens. Required when vektra-learn is active.
# VEKTRA_LEARN_JWT_SECRET=

# Require Vektra enrollment record for learn queries.
# Set to false when an external LMS (e.g. Moodle) manages enrollment.
# When false, namespace is derived from JWT (namespace claim or course_id fallback).
# VEKTRA_LEARN_REQUIRE_ENROLLMENT=true

# Default visibility of the source-citations section in the chatbot widget
# (FEAT-014). Resolution chain: data-show-sources attr (client) >
# namespaces.config.show_sources (per-course) > this env var > hardcoded true.
# The API always returns the full sources list; this flag only instructs the
# widget whether to render them.
# VEKTRA_LEARN_SHOW_SOURCES=true

# --------------------------------------------------------------------------
# Assessment discussion (vektra-assess). Dormant unless enabled.
# --------------------------------------------------------------------------
# Enable with the Compose overlay, which sets these for its services:
#   make assess-keys
#   docker compose -f docker-compose.yml -f docker-compose.assess.yml --profile assess up -d
# Secrets (keys, WS tokens, SMTP, role passwords) are Docker secret files under
# ./secrets/assess, NEVER variables in this file: a process that finds a key it must
# not hold in its environment refuses to start. The DSNs carry no password.
# VEKTRA_ASSESS_ENABLED=false
# VEKTRA_ASSESS_API_DATABASE_URL=postgresql+asyncpg://vektra_assess_api@postgres:5432/vektra
# VEKTRA_ASSESS_API_POOL_SIZE=15
# VEKTRA_ASSESS_HEARTBEAT_MAX_AGE_S=60
# VEKTRA_ASSESS_MOODLE_CA_FILE=
# VEKTRA_ASSESS_MOODLE_ALLOWED_CIDRS=10.20.0.0/16
# VEKTRA_ASSESS_MOODLE_ALLOW_HTTP=false
# VEKTRA_ASSESS_WS_RPS=10
# VEKTRA_ASSESS_INGEST_ACCOUNT_USERNAME=
# VEKTRA_ASSESS_UI_ORIGIN=https://assess-ui.example.org
# VEKTRA_ASSESS_API_PUBLIC_ORIGIN=https://assess-api.example.org
# Parser sidecar limits (non-secret; read by the parser and, for the client budget, the worker)
# Worker job loop (plan assess-job-loop); defaults shown, see docs/reference/configuration.md
# VEKTRA_ASSESS_WORKER_POOL_SIZE=5
# VEKTRA_ASSESS_WORKER_HEARTBEAT_INTERVAL_S=5
# VEKTRA_ASSESS_JOB_POLL_INTERVAL_S=1
# VEKTRA_ASSESS_JOB_BACKOFF_BASE_S=5
# VEKTRA_ASSESS_JOB_BACKOFF_CAP_S=300
# VEKTRA_ASSESS_JOB_DONE_RETENTION_H=24
# VEKTRA_ASSESS_WORKER_DRAIN_S=20
# VEKTRA_ASSESS_WORKER_DB_COMMAND_TIMEOUT_S=30
# VEKTRA_ASSESS_WORKER_WEDGE_EXIT_S=60
# VEKTRA_ASSESS_PREFLIGHT_CONCURRENCY=10
# VEKTRA_ASSESS_WORKER_ALLOW_UNBOUND=false   # development only: start with unbound handlers
# VEKTRA_ASSESS_PARSER_POOL=3
# VEKTRA_ASSESS_PARSER_TIMEOUT_S=10
# VEKTRA_ASSESS_PARSER_MAX_CHARS=200000
# VEKTRA_ASSESS_PARSER_MAX_FILE_BYTES=10485760
# VEKTRA_ASSESS_PARSER_MAX_PAGES=50
# VEKTRA_ASSESS_PARSER_RLIMIT_AS_MB=256
# Discussion runner (plan assess-llm-runner); see docs/reference/configuration.md
# VEKTRA_ASSESS_LLM_MODEL=ollama/qwen2.5:14b    # required when enabled; no fallback model
# VEKTRA_ASSESS_LLM_API_BASE=http://ollama:11434
# The discussion model's key is VEKTRA_LLM_API_KEY (shared with the RAG, see above); the worker gets
# it, the model, the base and the extra body through its environment in docker-compose.assess.yml.
# VEKTRA_ASSESS_LLM_EXTRA_BODY={"chat_template_kwargs": {"enable_thinking": false}}   # e.g. Qwen3 on vLLM
# VEKTRA_ASSESS_LLM_TEMPERATURE=0.2
# VEKTRA_ASSESS_LLM_MAX_TOKENS=600
# VEKTRA_ASSESS_LLM_CONTEXT_WINDOW=8192
# VEKTRA_ASSESS_LLM_SEED=
# VEKTRA_ASSESS_OUTAGE_TIMEOUT_S=45
# REQ-086 G: a shorter outage earns no time back; the cumulative credit is capped at C
# VEKTRA_ASSESS_OUTAGE_MIN_CREDIT_S=20
# VEKTRA_ASSESS_LLM_PRICE_PER_1K_IN=
# VEKTRA_ASSESS_LLM_PRICE_PER_1K_OUT=
# VEKTRA_ASSESS_SAFEGUARD_MODE=presidio          # 'none' only explicitly; presidio failing to load stops startup
# VEKTRA_ASSESS_STORE_TRACES=true
# VEKTRA_ASSESS_PROVIDER_LOCALITY=cloud          # 'onprem' only for the institution's own hardware
# VEKTRA_ASSESS_LLM_ALLOW_UNACTIVATED=false      # development only: serve discussions without an NFR-023 activation
# Student session lifecycle (plan assess-session-lifecycle)
# VEKTRA_ASSESS_TOKEN_ISSUER=vektra-assess
# VEKTRA_ASSESS_PRESESSION_TTL_S=120            # at most 120; larger refuses startup
# VEKTRA_ASSESS_SESSION_TOKEN_TTL_S=900
# VEKTRA_ASSESS_REPLY_GRACE_S=60
# VEKTRA_ASSESS_MIN_PLUGIN_VERSION=0.1.0
# VEKTRA_ASSESS_START_T_S=60
# VEKTRA_ASSESS_ADMISSION_K=10
# VEKTRA_ASSESS_PRIVACY_NOTICE_VERSION=1
# VEKTRA_ASSESS_ENROLMENT_FRESHNESS_S=150
# VEKTRA_ASSESS_MAX_MESSAGE_CHARS=2000        # provisional, sized by M5.1
# VEKTRA_ASSESS_RENDER_FRESH_S=300
# VEKTRA_ASSESS_STATE_RPM=30
# VEKTRA_ASSESS_PRIVACY_ALLOW_UNSET=false       # development only: BR-006 (h) without the REQ-089 store
# Eval suite only (make eval-assess): the pinned judge
# VEKTRA_ASSESS_JUDGE_MODEL=
# VEKTRA_ASSESS_JUDGE_API_BASE=
# VEKTRA_ASSESS_JUDGE_LOCALITY=cloud             # onprem required for a non-synthetic dataset
